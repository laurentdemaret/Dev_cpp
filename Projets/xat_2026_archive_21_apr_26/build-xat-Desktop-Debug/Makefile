####### Compile

main.o: ../Code/main.cpp ../Code/IO.h \
		../Code/matrix.h \
		../Code/bitstr.h \
		../Code/PGM.h \
		../Code/PointGrid.h \
		../Code/Point2D.h \
		../Code/Triangulation.h \
		../Code/Edge.h \
		../Code/Triangle.h \
		../Code/Thinning.h \
		../Code/fib.h \
		../Code/coding.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../Code/main.cpp

IO.o: ../Code/IO.cpp ../Code/IO.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o IO.o ../Code/IO.cpp

